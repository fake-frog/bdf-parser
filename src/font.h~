typedef union {
  char *name;
  int val;
} HeaderField;

typedef struct {
  HeaderField *header_fields;
  char c;
  int bitmap_size;
  int pixel_size;
  unsigned int rows[];
} Bitmap;

typedef struct {
  int header_fields_size;
  HeaderField *header_fields;
  int bitmaps_size;
  Bitmap **bitmaps;
  int pixel_size;
} Font;

int read_header(FILE *file, Font *font);

Bitmap *read_bitmap(FILE *file, int pixel_size);
