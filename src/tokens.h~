#ifndef TOKEN_H
#define TOKEN_H

// TODO - add full list of tokens

typedef enum {
  CAP_HEIGHT,
  X_HEIGTH,
  PIXEL_SIZE,
  QUAD_WIDTH,
  FONT_DESCENT,
  FONT_ASCENT,
  ENCODING,
  BITMAP,
  ENDCHAR,
  ENDFONT,
  CHARS,
  SKIP
} Token;

// clang-format off
const char *tokens_strings[] = {
  [CAP_HEIGHT]    = "CAP_HEIGHT",
  [X_HEIGTH]      = "X_HEIGHT",
  [PIXEL_SIZE]    = "PIXEL_SIZE",
  [QUAD_WIDTH]    = "QUAD_WIDTH",
  [FONT_DESCENT]  = "FONT_DESCENT",
  [FONT_ASCENT]   = "FONT_ASCENT",
  [ENCODING]      = "ENCODING",
  [BITMAP]        = "BITMAP",
  [ENDCHAR]       = "ENDCHAR",
  [CHARS]         = "CHARS",
  [ENDFONT]       = "ENDFONT"
};
// clang-format on

Token find_token(char *line) {
  const int tokens_strings_size =
      sizeof(tokens_strings) / sizeof(tokens_strings[0]);
  char linecpy[256];
  strcpy(linecpy, line);
  linecpy[strcspn(linecpy, "\n")] = '\0';
  linecpy[strcspn(linecpy, " ")] = '\0';

  for (int i = 0; i < tokens_strings_size; i++) {
    if (strcmp(linecpy, tokens_strings[i]) == 0) {
      return i;
    }
  }
  return SKIP;
}

#endif
